{
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "PYTHONSAFEPATH": "1",
    "ANTHROPIC_BASE_URL": "${OMNIROUTE_BASE_URL}",
    "ANTHROPIC_AUTH_TOKEN": "${OMNIROUTE_AUTH_TOKEN}",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "cc/claude-fable-5-1[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "cc/claude-opus-5-5[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "cc/claude-sonnet-5-5[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "cc/claude-haiku-4-5-20251001"
  },
  "agent": "lead",
  "modelPicker": {
    "replaceBuiltInOptions": true,
    "options": [
      {
        "model": "cc/claude-fable-5-1[1m]",
        "label": "Claude Fable 5.1",
        "behavesAs": "claude-fable-5-1"
      },
      {
        "model": "cc/claude-opus-5-5[1m]",
        "label": "Claude Opus 5.5",
        "behavesAs": "claude-opus-5-5"
      },
      {
        "model": "cc/claude-sonnet-5-5[1m]",
        "label": "Claude Sonnet 5.5",
        "behavesAs": "claude-sonnet-5-5"
      },
      {
        "model": "cc/claude-haiku-4-5-20251001",
        "label": "Claude Haiku 4.5",
        "behavesAs": "claude-haiku-4-5"
      },
      {
        "model": "cx/gpt-6.1-sol",
        "label": "GPT-6.1 Sol",
        "behavesAs": "claude-fable-5-1"
      },
      {
        "model": "cx/gpt-6-sol[1m]",
        "label": "GPT-6 Sol",
        "behavesAs": "claude-opus-5-5"
      },
      {
        "model": "cx/gpt-5.6-sol[1m]",
        "label": "GPT-5.6 Sol",
        "behavesAs": "claude-opus-5-5"
      },
      {
        "model": "cx/gpt-6-luna[1m]",
        "label": "GPT-6 Luna",
        "behavesAs": "claude-sonnet-5-5"
      },
      {
        "model": "cx/gpt-5.5",
        "label": "GPT-5.5",
        "behavesAs": "claude-sonnet-5-5"
      },
      {
        "model": "cx/gpt-5.6-terra[1m]",
        "label": "GPT-5.6 Terra",
        "behavesAs": "claude-sonnet-5-5"
      },
      {
        "model": "cx/gpt-5.6-luna[1m]",
        "label": "GPT-5.6 Luna",
        "behavesAs": "claude-haiku-4-5"
      },
      {
        "model": "glm/glm-5.3[1m]",
        "label": "GLM 5.3",
        "behavesAs": "claude-opus-5-5"
      },
      {
        "model": "glm/glm-5.3-flash[1m]",
        "label": "GLM 5.3 Flash",
        "behavesAs": "claude-sonnet-5-5"
      },
      {
        "model": "combo/max-models",
        "label": "Max Models",
        "behavesAs": "claude-fable-5-1"
      },
      {
        "model": "combo/high-models",
        "label": "High Models",
        "behavesAs": "claude-opus-5-5"
      },
      {
        "model": "combo/mid-models",
        "label": "Mid Models",
        "behavesAs": "claude-sonnet-5-5"
      },
      {
        "model": "combo/lite-models",
        "label": "Lite Models",
        "behavesAs": "claude-haiku-4-5"
      },
      {
        "model": "auto/coding:free",
        "label": "Auto Coding Free",
        "behavesAs": "claude-sonnet-5-5"
      }
    ]
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/**)",
      "Read(~/.npmrc)",
      "Read(~/.config/google-chrome/**)",
      "Read(~/.config/chromium/**)",
      "Read(~/.config/BraveSoftware/**)",
      "Read(~/.thunderbird/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude/settings.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.gemini/oauth_creds.json)",
      "Read(~/.gemini/google_accounts.json)",
      "Read(~/.local/share/opencode/auth.json)",
      "Read(~/.nuget/NuGet/NuGet.Config)",
      "Read(~/.config/Slack/**)",
      "Read(~/.config/Code/User/globalStorage/**)",
      "Read(~/.config/VSCodium/User/globalStorage/**)",
      "Read(~/.claude.json)",
      "Read(**/.env)",
      "Bash(curl * -o *)",
      "Bash(curl * -O*)",
      "Bash(curl * --output *)",
      "Bash(wget *)",
      "Bash(* | sh)",
      "Bash(* | bash)",
      "Bash(* | zsh)",
      "Bash(python -c *)",
      "Bash(python3 -c *)",
      "Bash(chmod +x *)",
      "Bash(unzip *)",
      "Bash(tar -x*)",
      "Bash(tar x*)",
      "Bash(7z x *)",
      "Bash(claude -p *)",
      "Bash(claude --print *)",
      "Bash(opencode run *)",
      "Bash(codex exec *)",
      "Bash(* --dangerously-skip-permissions*)",
      "Bash(* --allow-dangerously-skip-permissions*)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(podman *)",
      "Bash(gh)",
      "Bash(gh *)",
      "mcp__serena__execute_shell_command",
      "mcp__playwright",
      "mcp__claude-in-chrome",
      "Edit(~/Configs/zsh/**)",
      "Edit(~/Configs/nixos/**)",
      "Edit(~/Configs/hyprland/**)",
      "Edit(~/Configs/waybar/**)",
      "Edit(~/Configs/quickshell/**)",
      "Edit(~/Configs/eww/**)",
      "Edit(~/Configs/rofi/**)",
      "Edit(~/Configs/swaync/**)",
      "Edit(~/Configs/kitty/**)",
      "Edit(~/Configs/zed/**)",
      "Edit(~/Configs/neovim/**)",
      "Edit(~/Configs/starship/**)",
      "Edit(~/Configs/oh-my-posh/**)",
      "Edit(~/Configs/albert/**)",
      "Edit(~/Configs/vs-codium/**)",
      "Edit(~/Configs/agent-ctrl/settings/**)",
      "Edit(~/Configs/agent-ctrl/rules/**)",
      "Edit(~/Configs/agent-ctrl/agents/**)",
      "Edit(~/Configs/agent-ctrl/skills/**)",
      "Edit(~/Configs/agent-ctrl/commands/**)",
      "Edit(~/.config/systemd/**)",
      "Edit(~/.config/autostart/**)",
      "Edit(~/.config/environment.d/**)",
      "Edit(~/.local/share/applications/**)",
      "Edit(~/.local/bin/**)",
      "Edit(~/.bun/bin/**)",
      "Edit(~/.cargo/bin/**)",
      "Edit(~/.npm-global/bin/**)",
      "Edit(~/.pub-cache/bin/**)",
      "Edit(~/go/bin/**)",
      "Edit(~/.dotnet/tools/**)",
      "Edit(~/.aspire/bin/**)",
      "Edit(~/.qoder/**)",
      "Edit(~/.config/opencode/**)",
      "Edit(~/.local/share/opencode/**)",
      "Edit(~/.codex/**)",
      "Edit(~/.gemini/**)",
      "Edit(~/Configs/Makefile)",
      "Edit(~/Configs/opencode.json)",
      "Bash(systemctl *)",
      "Bash(crontab *)",
      "Bash(nixos-rebuild *)",
      "Bash(home-manager *)",
      "Bash(nix profile install *)",
      "Bash(agent-ctrl apply *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "git push",
      "git push *",
      "gh",
      "gh *",
      "podman run --rm --network none *"
    ],
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.gnupg",
        "~/.aws",
        "~/.config/gh",
        "~/.docker",
        "~/.npmrc",
        "~/.config/google-chrome",
        "~/.config/chromium",
        "~/.config/BraveSoftware",
        "~/.thunderbird",
        "~/.claude/.credentials.json",
        "~/.claude/settings.json",
        "~/Configs/agent-ctrl/.env",
        "~/.codex/auth.json",
        "~/.gemini/oauth_creds.json",
        "~/.gemini/google_accounts.json",
        "~/.local/share/opencode/auth.json",
        "~/.nuget/NuGet/NuGet.Config",
        "~/.config/Slack",
        "~/.config/Code/User/globalStorage",
        "~/.config/VSCodium/User/globalStorage",
        "~/.claude.json"
      ],
      "denyWrite": [
        "~/Configs/zsh",
        "~/Configs/nixos",
        "~/Configs/hyprland",
        "~/Configs/waybar",
        "~/Configs/quickshell",
        "~/Configs/eww",
        "~/Configs/rofi",
        "~/Configs/swaync",
        "~/Configs/kitty",
        "~/Configs/zed",
        "~/Configs/neovim",
        "~/Configs/starship",
        "~/Configs/oh-my-posh",
        "~/Configs/albert",
        "~/Configs/vs-codium",
        "~/Configs/agent-ctrl/settings",
        "~/Configs/agent-ctrl/rules",
        "~/Configs/agent-ctrl/agents",
        "~/Configs/agent-ctrl/skills",
        "~/Configs/agent-ctrl/commands",
        "~/.config/systemd",
        "~/.config/autostart",
        "~/.config/environment.d",
        "~/.local/share/applications",
        "~/.local/bin",
        "~/.bun/bin",
        "~/.cargo/bin",
        "~/.npm-global/bin",
        "~/.pub-cache/bin",
        "~/go/bin",
        "~/.dotnet/tools",
        "~/.aspire/bin",
        "~/.qoder",
        "~/.config/opencode",
        "~/.local/share/opencode",
        "~/.codex",
        "~/.gemini",
        "~/Configs/Makefile",
        "~/Configs/opencode.json"
      ]
    },
    "network": {
      "strictAllowlist": true,
      "allowedDomains": [
        "HOME_SERVER_HOST",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "models.dev",
        "cache.nixos.org"
      ],
      "deniedDomains": [
        "pastebin.com",
        "transfer.sh",
        "*.ngrok.io",
        "*.ngrok-free.app",
        "webhook.site",
        "requestbin.net",
        "*.trycloudflare.com"
      ]
    },
    "credentials": {
      "envVars": [
        {
          "name": "ANTHROPIC_AUTH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "OMNIROUTE_AUTH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "OMNIROUTE_API_KEY",
          "mode": "deny"
        },
        {
          "name": "DOKPLOY_API_KEY",
          "mode": "deny"
        },
        {
          "name": "HF_TOKEN",
          "mode": "deny"
        },
        {
          "name": "CLAUDE_CODE_MESSAGING_TOKEN",
          "mode": "deny"
        }
      ]
    }
  },
  "includeCoAuthoredBy": false,
  "disableRemoteControl": true,
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@2.2.30",
    "padding": 0,
    "refreshInterval": 10
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog",
        "hooks": [
          { "type": "command", "command": "sh \"$HOME/.agent-ctrl/settings/claude/notify.sh\" \"🔐 Girdi bekliyor\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"$HOME/.agent-ctrl/settings/claude/notify.sh\" \"✅ Tamamlandı\"" }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "keep-awake@claude-community": true,
    "cc-plugin-you-should-know@builtin": true
  }
}
