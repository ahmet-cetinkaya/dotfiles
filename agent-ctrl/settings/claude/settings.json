{
  "showThinkingSummaries": true,
  "askUserQuestionTimeout": "10m",
  "preferredNotifChannel": "notifications_disabled",
  "agent": "lead",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "disableRemoteControl": true,

  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "PYTHONSAFEPATH": "1",
    "CLAUDE_CODE_NEW_INIT": "1",

    "ANTHROPIC_BASE_URL": "${OMNIROUTE_BASE_URL}",
    "ANTHROPIC_AUTH_TOKEN": "${OMNIROUTE_AUTH_TOKEN}",

    "ANTHROPIC_DEFAULT_FABLE_MODEL": "cc/claude-fable-5-1[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "cc/claude-opus-5-5[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "cc/claude-sonnet-5-5[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "cc/claude-haiku-5-5",

    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },

  "modelPicker": {
    "replaceBuiltInOptions": true,
    "options": [
      {
        "model": "cc/claude-fable-5-1[1m]",
        "label": "Claude Fable 5.1",
        "behavesAs": "claude-fable-5-1"
      },
      {
        "model": "cc/claude-opus-5-5[1m]",
        "label": "Claude Opus 5.5",
        "behavesAs": "claude-opus-5-5"
      },
      {
        "model": "cc/claude-sonnet-5-5[1m]",
        "label": "Claude Sonnet 5.5",
        "behavesAs": "claude-sonnet-5-5"
      },
      {
        "model": "cc/claude-haiku-5-5",
        "label": "Claude Haiku 5.5",
        "behavesAs": "claude-haiku-5-5"
      },
      {
        "model": "cx/gpt-6-luna[1m]",
        "label": "GPT-6 Luna",
        "behavesAs": "claude-haiku-5-5"
      },
      {
        "model": "glm/glm-5.3[1m]",
        "label": "GLM 5.3",
        "behavesAs": "claude-opus-5-5"
      },
      {
        "model": "glm/glm-5.3-flash[1m]",
        "label": "GLM 5.3 Flash",
        "behavesAs": "claude-sonnet-5-5"
      },
      {
        "model": "combo/max-models",
        "label": "Max Models",
        "behavesAs": "claude-fable-5-1"
      },
      {
        "model": "combo/high-models",
        "label": "High Models",
        "behavesAs": "claude-opus-5-5"
      },
      {
        "model": "combo/mid-models",
        "label": "Mid Models",
        "behavesAs": "claude-sonnet-5-5"
      },
      {
        "model": "combo/lite-models",
        "label": "Lite Models",
        "behavesAs": "claude-haiku-5-5"
      },
      {
        "model": "auto/coding:free",
        "label": "Auto Coding Free",
        "behavesAs": "claude-sonnet-5-5"
      }
    ]
  },

  "modelSettings": {
    "combo/max-models": {
      "autoCompactWindow": 800000
    },
    "combo/high-models": {
      "autoCompactWindow": 800000
    },
    "combo/mid-models": {
      "autoCompactWindow": 800000
    },
    "combo/lite-models": {
      "autoCompactWindow": 800000
    },

    "cx/gpt-6-luna[1m]": {
      "autoCompactWindow": 800000
    }
  },

  "permissions": {
    "additionalDirectories": ["${SECOND_BRAIN_DIR}"],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/**)",
      "Read(~/.npmrc)",
      "Read(~/.config/google-chrome/**)",
      "Read(~/.config/chromium/**)",
      "Read(~/.config/BraveSoftware/**)",
      "Read(~/.thunderbird/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude/settings.json)",
      "Read(~/Configs/agent-ctrl/.env)",
      "Read(~/.codex/auth.json)",
      "Read(~/.gemini/oauth_creds.json)",
      "Read(~/.gemini/google_accounts.json)",
      "Read(~/.local/share/opencode/auth.json)",
      "Read(~/.nuget/NuGet/NuGet.Config)",
      "Read(~/.config/Slack/**)",
      "Read(~/.config/Code/User/globalStorage/**)",
      "Read(~/.config/VSCodium/User/globalStorage/**)",
      "Read(~/.claude.json)",
      "Read(~/Configs/zsh/.env)",
      "Read(**/.env)"
    ],
    "allow": [
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(gh pr list)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr status)",
      "Bash(gh pr status *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checkout *)",
      "Bash(gh issue list)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue status)",
      "Bash(gh run list)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh workflow list)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(gh repo view)",
      "Bash(gh repo view *)",
      "Bash(gh release list)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh label list)",
      "Bash(gh label list *)",
      "Bash(gh search *)",
      "Bash(gh auth status)",
      "Bash(gh auth status *)",
      "Bash(gh --version)",
      "Bash(podman ps)",
      "Bash(podman ps *)",
      "Bash(podman images)",
      "Bash(podman images *)",
      "Bash(podman logs *)",
      "Bash(podman inspect *)",
      "Bash(podman version)",
      "Bash(podman info)",
      "Bash(podman pull *)",
      "Bash(podman build *)",
      "Bash(podman start *)",
      "Bash(podman stop *)",
      "Bash(podman restart *)",
      "Bash(podman compose *)",
      "Bash(docker ps)",
      "Bash(docker ps *)",
      "Bash(docker images)",
      "Bash(docker images *)",
      "Bash(docker logs *)",
      "Bash(docker inspect *)",
      "Bash(docker version)",
      "Bash(docker info)",
      "Bash(docker pull *)",
      "Bash(docker build *)",
      "Bash(docker start *)",
      "Bash(docker stop *)",
      "Bash(docker restart *)",
      "Bash(docker compose *)",
      "Bash(aspire run)",
      "Bash(aspire run *)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr reopen *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh pr ready *)",
      "Bash(gh issue create *)",
      "Bash(gh issue close *)",
      "Bash(gh issue reopen *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue delete *)",
      "Bash(gh issue transfer *)",
      "Bash(gh repo create *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo sync *)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(gh release edit *)",
      "Bash(gh release upload *)",
      "Bash(gh run cancel *)",
      "Bash(gh run rerun *)",
      "Bash(gh run delete *)",
      "Bash(gh workflow run *)",
      "Bash(gh workflow enable *)",
      "Bash(gh workflow disable *)",
      "Bash(gh label create *)",
      "Bash(gh label delete *)",
      "Bash(gh label edit *)",
      "Bash(gh api *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh auth login *)",
      "Bash(gh auth logout *)",
      "Bash(gh auth refresh *)",
      "Bash(gh auth token *)",
      "Bash(gh gist *)",
      "Bash(gh ssh-key *)",
      "Bash(gh gpg-key *)",
      "Bash(gh extension *)",
      "Bash(podman run *)",
      "Bash(podman exec *)",
      "Bash(podman rm *)",
      "Bash(podman rmi *)",
      "Bash(podman system *)",
      "Bash(podman volume *)",
      "Bash(podman push *)",
      "Bash(podman login *)",
      "Bash(docker run *)",
      "Bash(docker exec *)",
      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(docker system *)",
      "Bash(docker volume *)",
      "Bash(docker push *)",
      "Bash(docker login *)",
      "Bash(aspire publish *)",
      "Bash(aspire deploy *)",
      "Bash(agent-ctrl apply *)",
      "mcp__serena__execute_shell_command",
      "Edit(~/Configs/zsh/**)",
      "Edit(~/Configs/agent-ctrl/settings/claude/**)",
      "Edit(~/Configs/nixos/modules/apps/ai/**)",
      "Edit(**/.claude/claude-launcher.local.json)",
      "Edit(**/.claude/additional-dirs.local)"
    ]
  },

  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "excludedCommands": [
      "gh",
      "gh *",
      "git push",
      "git push *",
      "git commit",
      "git commit *",
      "git fetch",
      "git fetch *",
      "git pull",
      "git pull *",
      "git branch",
      "git branch *",
      "podman *",
      "docker *",
      "aspire *",
      "agent-ctrl apply *"
    ],
    "filesystem": {
      "allowWrite": ["~/.npm"],
      "denyWrite": [
        "~/.zshrc",
        "~/.zshenv",
        "~/.bashrc",
        "~/.profile",
        "~/Configs/zsh",
        "~/.config/autostart",
        "~/.config/environment.d",
        "~/.config/systemd",
        "~/.local/bin",
        "~/.local/share/applications",
        "~/.dotnet/tools",
        "~/.claude/settings.json",
        "~/.claude.json",
        "~/Configs/agent-ctrl/settings/claude",
        "~/Configs/nixos"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.gnupg",
        "~/.aws",
        "~/.config/gh",
        "~/.docker",
        "~/.npmrc",
        "~/.config/google-chrome",
        "~/.config/chromium",
        "~/.config/BraveSoftware",
        "~/.thunderbird",
        "~/.claude/.credentials.json",
        "~/.claude/settings.json",
        "~/Configs/agent-ctrl/.env",
        "~/.codex/auth.json",
        "~/.gemini/oauth_creds.json",
        "~/.gemini/google_accounts.json",
        "~/.local/share/opencode/auth.json",
        "~/.nuget/NuGet/NuGet.Config",
        "~/.config/Slack",
        "~/.config/Code/User/globalStorage",
        "~/.config/VSCodium/User/globalStorage",
        "~/.claude.json",
        "~/Configs/zsh/.env"
      ]
    },
    "network": {
      "strictAllowlist": false,
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "cache.nixos.org",
        "models.dev",
        "192.168.1.2:3020"
      ],
      "deniedDomains": [
        "pastebin.com",
        "transfer.sh",
        "*.ngrok.io",
        "*.ngrok-free.app",
        "webhook.site",
        "requestbin.net",
        "*.trycloudflare.com"
      ]
    },
    "credentials": {
      "envVars": [
        {
          "name": "ANTHROPIC_AUTH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "OMNIROUTE_AUTH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "OMNIROUTE_API_KEY",
          "mode": "deny"
        },
        {
          "name": "DOKPLOY_API_KEY",
          "mode": "deny"
        },
        {
          "name": "HF_TOKEN",
          "mode": "deny"
        },
        {
          "name": "CLAUDE_CODE_MESSAGING_TOKEN",
          "mode": "deny"
        },
        {
          "name": "WHPH_MCP_TOKEN",
          "mode": "deny"
        }
      ]
    }
  },

  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.agent-ctrl/settings/claude/notify.sh\" \"🔐 Girdi bekliyor\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.agent-ctrl/settings/claude/notify.sh\" \"✅ Tamamlandı\""
          }
        ]
      }
    ]
  },

  "enabledPlugins": {
    "keep-awake@claude-community": true,
    "cc-plugin-you-should-know@builtin": true
  },

  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@2.2.30",
    "padding": 0,
    "refreshInterval": 10
  }
}
