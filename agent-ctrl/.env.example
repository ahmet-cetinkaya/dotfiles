# Example agent-ctrl integration credentials
# Copy these keys into .env and populate them with real values.
# SkillsMP API key: https://skillsmp.com/docs/api
# Smithery API key: https://smithery.ai/account/api-keys

SKILLSMP_API_KEY=your-skillsmp-api-key

SMITHERY_API_KEY=your-smithery-api-key

CONTEXT7_API_KEY=your-context7-api-key

CHROMIUM_PATH=/path/to/chromium

MORPH_KEY=your-morph-api-key

AFFINE_URL=your-affine-url
AFFINE_WORKSPACE_ID=your-affine-workspace-id
AFFINE_EMAIL=your-affine-service-account-email
AFFINE_PASSWORD=your-affine-service-account-password
AFFINE_MCP_TOKEN=your-official-affine-mcp-credential

# Claude Code additional working directory, substituted into settings.json as ${SECOND_BRAIN_DIR}
SECOND_BRAIN_DIR=/path/to/ACBrain
